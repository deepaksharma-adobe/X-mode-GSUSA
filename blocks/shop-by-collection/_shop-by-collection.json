{
  "definitions": [
    {
      "title": "Shop By Collection",
      "id": "shop-by-collection",
      "model": "shop-by-collection",
      "filter": "shop-by-collection"
    },
    {
      "title": "Shop By Collection (Infinite Loop)",
      "id": "shop-by-collection-infinite-loop",
      "model": "shop-by-collection",
      "filter": "shop-by-collection",
      "plugins": {
        "da": {
          "classes": ["infinite-loop"]
        }
      }
    },
    {
      "title": "Collection Card",
      "id": "shop-by-collection-card",
      "model": "shop-by-collection-card",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 2,
          "fields": [
            { "name": "image", "selector": "div:nth-child(1)>picture>img[src]" },
            { "name": "imageAlt", "selector": "div:nth-child(1)>picture>img[alt]" },
            { "name": "content", "selector": "div:nth-child(2)" }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "shop-by-collection-card",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Image",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Image Alt"
        },
        {
          "component": "richtext",
          "name": "content",
          "label": "Content (collection title + link)",
          "valueType": "string"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "shop-by-collection",
      "components": ["shop-by-collection-card"]
    }
  ]
}
