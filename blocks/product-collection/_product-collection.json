          "value": true
        },
        {
          "component": "text",
          "name": "bgColor",
          "label": "Background Color",
          "description": "Optional. Any CSS color — a hex code (e.g. #f6f3ec) or a color name (e.g. cornsilk). Applied to the full-width section behind the collection."
        },
        {
          "component": "select",
          "name": "headingAlign",
