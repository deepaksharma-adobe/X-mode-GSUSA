            { "name": "On", "value": "" },
            { "name": "Off", "value": "off" }
          ]
        },
        {
          "component": "select",
          "name": "waveCurve",
          "label": "Wave Curve",
          "description": "Direction the wave peaks. Defaults to Peak Right.",
          "options": [
            { "name": "Peak Right", "value": "peak-right" },
            { "name": "Peak Left", "value": "peak-left" }
          ]
        }
      ]
